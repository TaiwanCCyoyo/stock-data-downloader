# Shioaji API Token 與憑證設定
API_KEY=<前面申請的API Key>
SECRET_KEY=<前面申請的Secret Key>
CA_CERT_PATH=<前面設定的憑證路徑，例如 C:/Users/.../SinoPac.pfx>
# CA 密碼通常預設為身份證字號（首字母大寫，共10碼），若有修改請填寫修改後的密碼
CA_PASSWORD=<憑證密碼>

# Backup destination: an absolute path outside this repository and outside the
# data directory. Unset skips the backup.
SHIOAJI_BACKUP_DIR=<e.g. D:/StockDataBackup>

# Optional data directory: an absolute, existing path outside this repository.
# Unset uses <repo>/data. Set it only in the production checkout's .env, never in
# a development worktree. See docs/operations.md#data-location.
# SHIOAJI_DATA_DIR=D:/StockData/stock-data-downloader
