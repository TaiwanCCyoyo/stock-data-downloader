# Shioaji API Token 與憑證設定
API_KEY=<前面申請的API Key>
SECRET_KEY=<前面申請的Secret Key>
CA_CERT_PATH=<前面設定的憑證路徑，例如 C:/Users/.../SinoPac.pfx>
# CA 密碼通常預設為身份證字號（首字母大寫，共10碼），若有修改請填寫修改後的密碼
CA_PASSWORD=<憑證密碼>

# 備份目的地（絕對路徑，必須在此 repo 與資料目錄之外）；未設定則略過備份
SHIOAJI_BACKUP_DIR=<例如 D:/StockDataBackup>

# 資料目錄（選填；絕對路徑、必須已存在、在此 repo 之外）。未設定則使用 <repo>/data。
# 只放在正式環境 checkout 的 .env；開發 worktree 不設定。見 docs/operations.md#data-location
# SHIOAJI_DATA_DIR=D:/StockData/stock-data-downloader
